name: CI Pipeline

on: [push, pull_request]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      
      - name: Setup Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'
      
      - name: Install dependencies
        run: pip install pytest
      
      - name: Lint check (статическая проверка)
        run: python -m py_compile app.py
      
      - name: Run unit tests
        run: pytest test_app.py -v
      
      - name: Check if build works (пункт 5 из CI)
        run: docker build --no-cache -t test-app .
